# Server configuration
PORT=4000
NODE_ENV=development

# JWT Secrets (Generate strong unique keys in production)
JWT_ACCESS_SECRET=supersecret_access_token_key_12345
JWT_REFRESH_SECRET=supersecret_refresh_token_key_67890

# Token Expiry (e.g. 15m, 1h, 7d)
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# CORS Client Origin
CLIENT_ORIGIN=http://localhost:5173
